# Embeddings: proveedor principal + respaldo opcional.
# Si el principal falla (caida de red, rate limit, sin credito), se reintenta
# automaticamente con el de respaldo.
#
# Proveedores disponibles: ollama (local, gratis, sin API key), voyage, openai
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_FALLBACK_PROVIDER=voyage

# --- Ollama (local, default recomendado si no tenes API keys) ---
# Requiere: instalar Ollama y correr "ollama pull nomic-embed-text"
# Puede correr en OTRO equipo de tu red (no necesita GPU, corre bien en CPU).
# Si es remoto: reemplaza localhost por la IP de ese equipo, ej:
#   OLLAMA_URL=http://192.168.1.50:11434
# y en ese equipo hay que levantar Ollama con OLLAMA_HOST=0.0.0.0:11434
# para que acepte conexiones desde la red (por default solo escucha en localhost).
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Voyage AI (recomendado como respaldo, tiene tier gratuito) ---
VOYAGE_API_KEY=tu_api_key_aqui
VOYAGE_MODEL=voyage-code-3

# --- OpenAI (alternativa) ---
# OPENAI_API_KEY=tu_api_key_aqui
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# IMPORTANTE: nomic-embed-text (Ollama) genera vectores de 768 dimensiones,
# voyage-code-3 genera 1024. Si el principal y el fallback tienen dimensiones
# distintas, Qdrant va a rechazar los upserts del que no coincide con la
# coleccion ya creada. Ver seccion "Proveedor de respaldo" en el README.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=code_knowledge

# API HTTP (consumida por Codex / otros agentes via curl)
PORT=4500

# Carpeta raiz donde estan los 12 proyectos, uno por subcarpeta
PROJECTS_ROOT=/ruta/a/tus/12-proyectos
